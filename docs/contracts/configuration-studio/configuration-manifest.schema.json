{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gigalibs.io/configuration/v1/compiled-manifest.schema.json",
  "title": "GigaLibs compiled configuration manifest",
  "description": "Language-neutral form of the immutable manifest emitted by CONFIGURATION_COMPILER_VERSION 1.0.0. Tenant and actor metadata remain outside this document; field-policy filtering may remove unauthorized fields and their section references before delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "moduleKey",
    "entityKey",
    "surfaceKey",
    "mode",
    "title",
    "fields",
    "sections",
    "compilerVersion",
    "checksum"
  ],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "moduleKey": { "$ref": "#/$defs/key" },
    "entityKey": { "$ref": "#/$defs/key" },
    "surfaceKey": { "$ref": "#/$defs/key" },
    "mode": { "enum": ["CREATE", "EDIT", "READ", "LIST"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 1000 },
    "fields": {
      "type": "array",
      "maxItems": 250,
      "items": { "$ref": "#/$defs/field" }
    },
    "sections": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/section" }
    },
    "listView": { "$ref": "#/$defs/listView" },
    "compilerVersion": { "const": "1.0.0" },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "permission": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9-]*:(?:\\*|[a-z][a-z0-9-]*)$"
    },
    "scalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "conditionValue": {
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        {
          "type": "array",
          "maxItems": 200,
          "items": { "type": ["string", "number", "boolean"] }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fieldKey", "operator"],
          "properties": {
            "kind": { "const": "PREDICATE" },
            "fieldKey": { "$ref": "#/$defs/key" },
            "operator": {
              "enum": [
                "EQUALS",
                "NOT_EQUALS",
                "IS_EMPTY",
                "IS_NOT_EMPTY",
                "GREATER_THAN",
                "GREATER_THAN_OR_EQUAL",
                "LESS_THAN",
                "LESS_THAN_OR_EQUAL",
                "IN",
                "CONTAINS"
              ]
            },
            "value": { "$ref": "#/$defs/conditionValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "combinator", "conditions"],
          "properties": {
            "kind": { "const": "GROUP" },
            "combinator": { "enum": ["ALL", "ANY"] },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": { "$ref": "#/$defs/condition" }
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 200 },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "type",
        "component",
        "required",
        "readOnly",
        "classification"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "helpText": { "type": "string", "maxLength": 500 },
        "type": {
          "enum": [
            "TEXT",
            "TEXTAREA",
            "NUMBER",
            "INTEGER",
            "BOOLEAN",
            "DATE",
            "DATETIME",
            "EMAIL",
            "PHONE",
            "URL",
            "CURRENCY",
            "SELECT",
            "MULTI_SELECT"
          ]
        },
        "component": {
          "enum": [
            "text-input",
            "textarea",
            "number-input",
            "checkbox",
            "date-input",
            "datetime-input",
            "select",
            "multi-select"
          ]
        },
        "required": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "classification": {
          "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
        },
        "readPermission": { "$ref": "#/$defs/permission" },
        "writePermission": { "$ref": "#/$defs/permission" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "patternKey": { "$ref": "#/$defs/key" },
        "options": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/option" }
        },
        "defaultValue": { "$ref": "#/$defs/scalar" },
        "visibleWhen": { "$ref": "#/$defs/condition" },
        "requiredWhen": { "$ref": "#/$defs/condition" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "columns", "fieldKeys"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 500 },
        "columns": { "type": "integer", "minimum": 1, "maximum": 3 },
        "fieldKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "quickFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "fieldKey", "operator"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "fieldKey": { "$ref": "#/$defs/key" },
        "operator": {
          "enum": [
            "EQUALS",
            "NOT_EQUALS",
            "IS_EMPTY",
            "IS_NOT_EMPTY",
            "GREATER_THAN",
            "GREATER_THAN_OR_EQUAL",
            "LESS_THAN",
            "LESS_THAN_OR_EQUAL",
            "IN",
            "CONTAINS"
          ]
        },
        "value": { "$ref": "#/$defs/scalar" }
      }
    },
    "listView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columnKeys", "defaultSortDirection"],
      "properties": {
        "columnKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/key" }
        },
        "defaultSortKey": { "$ref": "#/$defs/key" },
        "defaultSortDirection": { "enum": ["ASC", "DESC"] },
        "searchableFieldKeys": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/key" }
        },
        "quickFilters": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/quickFilter" }
        }
      }
    }
  }
}
