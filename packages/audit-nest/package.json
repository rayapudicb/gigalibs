{
  "name": "@gigalibs/audit-nest",
  "version": "0.0.1",
  "description": "Immutable activity log. Change diffs. IP capture. GDPR export [nest]",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/audit-nest",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@gigalibs/audit-core": "workspace:*",
    "@gigalibs/db": "workspace:*",
    "@gigalibs/rbac-nest": "workspace:*",
    "@gigalibs/tenancy-nest": "workspace:*",
    "@nestjs/common": "^11.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
