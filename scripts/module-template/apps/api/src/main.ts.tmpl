import 'reflect-metadata';
import { loadModuleListenerConfig } from '@gigalibs/module-sdk';
import { Logger } from '@nestjs/common';
import { NestFactory } from '@nestjs/core';
import helmet from 'helmet';
import { AppModule } from './app.module.js';

async function bootstrap(): Promise<void> {
  // Standalone service only (`hosting: service`); inside the module host, the host listens instead.
  const config = loadModuleListenerConfig({ prefix: '__PREFIX__' });
  const app = await NestFactory.create(AppModule, { bufferLogs: true });
  app.use(helmet());
  app.enableCors({
    origin: [...config.corsOrigins],
    credentials: true,
    methods: ['GET', 'POST', 'PATCH', 'OPTIONS'],
    allowedHeaders: ['Accept', 'Authorization', 'Content-Type', 'X-Correlation-Id'],
    exposedHeaders: ['Idempotency-Replayed', 'X-Correlation-Id'],
  });
  app.enableShutdownHooks();
  await app.listen(config.apiPort, config.apiHost);
  Logger.log(`__TITLE__ API is accepting connections on ${config.apiHost}:${config.apiPort}`, 'Bootstrap');
}

bootstrap().catch((error: unknown) => {
  new Logger('Bootstrap').error('__TITLE__ API failed to start.', error instanceof Error ? error.stack : undefined);
  process.exitCode = 1;
});
