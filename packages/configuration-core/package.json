{
  "name": "@gigalibs/configuration-core",
  "version": "0.1.0",
  "description": "Deterministic compiler and runtime validation for governed configuration manifests",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./condition": {
      "import": "./dist/condition.js",
      "types": "./dist/condition.d.ts"
    },
    "./format": {
      "import": "./dist/format.js",
      "types": "./dist/format.d.ts"
    },
    "./dictionary-evaluator": {
      "import": "./dist/dictionary-evaluator.js",
      "types": "./dist/dictionary-evaluator.d.ts"
    }

  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@gigalibs/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
