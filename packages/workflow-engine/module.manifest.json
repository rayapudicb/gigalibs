{
  "id": "gigalibs.workflow",
  "name": "Trigger-Condition-Action Workflow Automation",
  "version": "1.0.0",
  "description": "Trigger-Condition-Action state machine, asynchronous steps, human approvals, compensation, and execution history",
  "capabilities": [
    "workflow-state-machines",
    "trigger-condition-action",
    "step-retries",
    "approval-chains",
    "audit-timeline"
  ],
  "requires": {
    "gigalibs.tenancy": "^1.0.0",
    "gigalibs.audit": "^1.0.0"
  },
  "optional": {
    "gigalibs.rule-engine": "^1.0.0",
    "gigalibs.notifications": "^1.0.0"
  },
  "permissions": [
    "workflows.workflow.read",
    "workflows.workflow.create",
    "workflows.workflow.update",
    "workflows.workflow.execute",
    "workflows.workflow.approve"
  ],
  "eventsProduced": [
    "workflow.started.v1",
    "workflow.step_completed.v1",
    "workflow.completed.v1",
    "workflow.failed.v1"
  ],
  "eventsConsumed": [
    "tenant.created.v1",
    "invoice.paid.v1",
    "form.submission_received.v1"
  ],
  "configurationNamespace": "workflow",
  "healthChecks": [
    "database"
  ]
}
