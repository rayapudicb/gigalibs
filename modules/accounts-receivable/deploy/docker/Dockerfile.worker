ARG NODE_IMAGE=node:22-alpine
FROM ${NODE_IMAGE} AS builder
RUN corepack enable
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @gigalibs/ar-worker build
RUN pnpm --filter @gigalibs/ar-worker deploy --prod --legacy /opt/ar-worker

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production
WORKDIR /opt/ar-worker
COPY --from=builder --chown=node:node /opt/ar-worker/ ./
USER node
CMD ["node", "dist/main.js"]
