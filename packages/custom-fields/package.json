{
  "name": "@gigalibs/custom-fields",
  "version": "0.1.0",
  "description": "Dynamic schema extension. Per-tenant field definitions. JSON typed storage",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@gigalibs/crypto": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
