generator client {
  provider     = "prisma-client"
  output       = "./src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  MAINTENANCE
  TRIAL
  CANCELLED
}

enum TenantIsolationMode {
  ROW_LEVEL_SECURITY
  SCHEMA_ISOLATED
  DEDICATED_DATABASE
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DEACTIVATED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MemberRole {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  MEMBER
  VIEWER
  GUEST
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

// Platform authority is global and must never be inferred from a role held inside a tenant.
enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  PLATFORM_AUDITOR
}

enum PlatformRoleAssignmentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum ExternalIdentityStatus {
  ACTIVE
  REVOKED
}

enum OidcAuthorizationPurpose {
  LOGIN
  LINK
}

enum TenantModuleEntitlementStatus {
  ENABLED
  DISABLED
}

enum TenantModuleEntitlementSource {
  TRIAL
  PLAN
  PLATFORM_OVERRIDE
}

enum TenantInfrastructureStatus {
  REQUESTED
  PROVISIONING
  READY
  FAILED
}

enum TenantSubdomainStatus {
  RESERVED
  DNS_PENDING
  TLS_PENDING
  ACTIVE
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  INVITE
  PERMISSION_CHANGE
  SETTINGS_CHANGE
  PROVISION
  STATUS_CHANGE
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  UNPAID
  INCOMPLETE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  QUARANTINED
}

enum IngestionCadence {
  REALTIME_CDC
  SYNC_8_HOURS
  SYNC_24_HOURS
}

enum BillableSourceType {
  TIMESHEET_SHIFT
  MILESTONE_DELIVERABLE
  EXPENSE_RECORD
  EQUIPMENT_ASSET
  SERVICE_FEE
