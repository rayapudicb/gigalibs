{
  "name": "@gigalibs/module-sdk",
  "version": "0.1.0",
  "description": "Module SDK (ADR-0013 core): tenant-bound PostgreSQL runtime, ADR-0007 outbox relay, relay inbox guard, inbox receipts and outbox retention shared by business modules",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/module-sdk",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@gigalibs/auth-core": "workspace:*",
    "pg": "^8.23.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.2.3"
  },
  "devDependencies": {
    "@nestjs/common": "11.2.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
