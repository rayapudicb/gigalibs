    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "dejavu-fonts-ttf": "2.37.3",
    "docx": "9.5.1",
    "helmet": "^8.1.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.2"
