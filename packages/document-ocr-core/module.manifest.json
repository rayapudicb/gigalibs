{
  "id": "gigalibs.ocr",
  "name": "AI Document Intelligence & OCR Extraction",
  "version": "1.0.0",
  "description": "Optical Character Recognition, layout-aware financial invoice extraction, line item parser, and automated PII redaction mask detector",
  "capabilities": [
    "invoice-ocr",
    "tabular-line-items",
    "field-confidence-scoring",
    "pii-redaction-masking"
  ],
  "requires": {
    "gigalibs.tenancy": "^1.0.0"
  },
  "optional": {
    "gigalibs.storage": "^1.0.0",
    "gigalibs.invoices": "^1.0.0"
  },
  "permissions": [
    "ocr.document.parse",
    "ocr.document.read",
    "ocr.pii.unmask"
  ],
  "eventsProduced": [
    "ocr.extraction_completed.v1",
    "ocr.pii_detected.v1"
  ],
  "eventsConsumed": [
    "tenant.created.v1"
  ],
  "configurationNamespace": "ocr",
  "healthChecks": [
    "ocr-engine"
  ]
}
