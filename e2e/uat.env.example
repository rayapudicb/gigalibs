# Copy to e2e/uat.env (gitignored). Used by run-uat-walkthrough.sh and pnpm e2e:uat:* — no prompts when set.
#
#   cp e2e/uat.env.example e2e/uat.env
#   # edit e2e/uat.env with real values (never commit uat.env)

PLAYWRIGHT_TEST_BASE_URL=http://127.0.0.1:5180

E2E_UAT_ADMIN_EMAIL=uat.admin@gigalibs.io
E2E_UAT_ADMIN_PASSWORD=

# Optional: when the login belongs to several workspaces
# E2E_UAT_TENANT=GigaLibs Global Enterprise

# For --approvals, --ledger, --all
# E2E_UAT_APPROVER_EMAIL=uat.approver@gigalibs.io
# E2E_UAT_APPROVER_PASSWORD=

# For --journey (12+ characters; used only for newly signed-up journey users)
# E2E_JOURNEY_PASSWORD=

# WI-OI-130 IoT MaaS ingest spec (optional; device provisioned in UI or API first)
# IOT_E2E_API_URL=http://127.0.0.1:4250
# IOT_E2E_DEVICE_ID=
# IOT_E2E_DEVICE_CREDENTIAL=

# WI-OI-133 Operator Rounds API journey. Use existing UAT asset, Workforce resource, and four users.
# The author and publisher must be different; publisher needs operator-rounds.routes.publish.
# ROUNDS_BASE_URL=https://your-uat-domain.example
# ROUNDS_ASSET_ID=
# ROUNDS_WORKFORCE_RESOURCE_ID=
# ROUNDS_AUTHOR_EMAIL=
# ROUNDS_AUTHOR_PASSWORD=
# ROUNDS_PUBLISHER_EMAIL=
# ROUNDS_PUBLISHER_PASSWORD=
# ROUNDS_SUPERVISOR_EMAIL=
# ROUNDS_SUPERVISOR_PASSWORD=
# ROUNDS_OPERATOR_EMAIL=
# ROUNDS_OPERATOR_PASSWORD=
# ROUNDS_APP_PROFILE=gigalibs-universal
# ROUNDS_APP_VERSION=1.0.0
