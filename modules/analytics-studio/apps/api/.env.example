NODE_ENV="development"
ANALYTICS_ALLOW_INSECURE_OIDC="true"
ANALYTICS_API_HOST="127.0.0.1"
ANALYTICS_API_PORT="4400"
ANALYTICS_CORS_ORIGINS="http://localhost:5180,http://127.0.0.1:5180"
ANALYTICS_DATABASE_URL="postgresql://spend_runtime:spend_runtime_pass_2026@localhost:5432/ar"
ANALYTICS_DATABASE_POOL_SIZE="10"
ANALYTICS_EXPECTED_MIGRATION_VERSION="29"
ANALYTICS_WORKFORCE_INBOX_RELAY_PUBLIC_KEY_BASE64="REPLACE_WITH_ED25519_SPKI_DER_BASE64"
ANALYTICS_OIDC_ISSUER="http://127.0.0.1:4400/oidc/dev"
ANALYTICS_OIDC_AUDIENCE="gigalibs-analytics-api"
ANALYTICS_OIDC_JWKS_URI="http://127.0.0.1:4400/oidc/dev/.well-known/jwks.json"
ANALYTICS_OIDC_ALGORITHMS="RS256"
ANALYTICS_OIDC_TENANT_CLAIM="tenant_id"
ANALYTICS_OIDC_PERMISSIONS_CLAIM="permissions"
