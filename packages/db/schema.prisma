model GeneralLedgerAccount {
  id       String @id @default(cuid())
  code     String // 1000 Cash, 1200 AR, 2200 Tax, 4000 Revenue
  name     String
  type     String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  currency String @default("USD")

  lines JournalLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code])
  @@map("general_ledger_accounts")
}

model JournalEntry {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  entryNumber  String
  memo         String
  sourceModule String   @default("INVOICING")
  referenceId  String?
  postedAt     DateTime @default(now())
  isBalanced   Boolean  @default(true)

  lines JournalLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, entryNumber])
  @@index([tenantId])
  @@map("journal_entries")
}

model JournalLineItem {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountCode String
  account     GeneralLedgerAccount @relation(fields: [accountCode], references: [code], onDelete: Restrict)

  description String?
  debitCents  BigInt  @default(0)
  creditCents BigInt  @default(0)

  @@index([entryId])
  @@index([accountCode])
  @@map("journal_line_items")
}

model LedgerGenesisRecord {
  tenantId    String   @id @map("tenant_id")
  genesisHash String   @map("genesis_hash") @db.Char(64)
