{
  "id": "gigalibs.ai-chat",
  "name": "AI Copilot & LLM Streaming (SSE)",
  "version": "1.0.0",
  "description": "Enterprise Conversational AI Copilot, Server-Sent Events (SSE) token streaming, context window trimmer, and prompt composition",
  "capabilities": [
    "sse-streaming",
    "token-estimation",
    "context-trimming",
    "prompt-composition",
    "agentic-tools"
  ],
  "requires": {
    "gigalibs.tenancy": "^1.0.0"
  },
  "optional": {
    "gigalibs.audit": "^1.0.0"
  },
  "permissions": [
    "ai.chat.query",
    "ai.model.configure"
  ],
  "eventsProduced": [
    "ai.query_completed.v1",
    "ai.token_usage_recorded.v1"
  ],
  "eventsConsumed": [
    "tenant.created.v1"
  ],
  "configurationNamespace": "ai",
  "healthChecks": [
    "llm-gateway"
  ]
}
