{
  "id": "gigalibs.form-engine",
  "name": "Dynamic Forms & PostgreSQL JSONB Engine",
  "version": "1.0.0",
  "description": "Visual form schema builder, conditional logic branching (SHOW_IF, HIDE_IF), validation engine, and PostgreSQL JSONB GIN index generator",
  "capabilities": [
    "dynamic-schemas",
    "conditional-logic",
    "field-validation",
    "jsonb-storage",
    "postgres-ddl-generator"
  ],
  "requires": {
    "gigalibs.tenancy": "^1.0.0",
    "gigalibs.audit": "^1.0.0"
  },
  "optional": {},
  "permissions": [
    "forms.form.read",
    "forms.form.create",
    "forms.form.update",
    "forms.form.delete",
    "forms.submission.read",
    "forms.submission.create",
    "forms.submission.export"
  ],
  "eventsProduced": [
    "form.created.v1",
    "form.updated.v1",
    "form.submission_received.v1"
  ],
  "eventsConsumed": [
    "tenant.created.v1"
  ],
  "configurationNamespace": "forms",
  "healthChecks": [
    "database"
  ]
}
