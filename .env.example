# Copy to .env for local development only. Replace every REPLACE_* value with a unique random secret.
# This file intentionally contains no working default credentials.

# Database
DATABASE_URL="postgresql://gigalibs:REPLACE_WITH_CONTROL_DB_PASSWORD@localhost:5440/gigalibs"
CONTROL_DB_USER="gigalibs"
CONTROL_DB_PASSWORD="REPLACE_WITH_CONTROL_DB_PASSWORD"
CONTROL_DB_NAME="gigalibs"
CONTROL_DB_PORT="5440"

# Redis
REDIS_URL="redis://:REPLACE_WITH_CONTROL_REDIS_PASSWORD@localhost:6381"
CONTROL_REDIS_PASSWORD="REPLACE_WITH_CONTROL_REDIS_PASSWORD"
CONTROL_REDIS_PORT="6381"

# Storage (MinIO)
STORAGE_ENDPOINT="http://localhost:9010"
STORAGE_ACCESS_KEY="gigalibs"
STORAGE_SECRET_KEY="REPLACE_WITH_STORAGE_SECRET_KEY"
STORAGE_BUCKET="gigalibs-dev"
STORAGE_REGION="us-east-1"
STORAGE_FORCE_PATH_STYLE="true"
STORAGE_ALLOW_INSECURE="true"
STORAGE_PRESIGN_SECONDS="900"
STORAGE_MAX_FILE_BYTES="10485760"
STORAGE_CLEANUP_INTERVAL_SECONDS="60"
STORAGE_CLEANUP_BATCH_SIZE="100"
# Optional capability configuration. Without both signing values, export requests fail closed while
# the rest of the application remains available. The private key is base64 PKCS8 DER, never PEM.
TENANT_EXPORT_SIGNING_KEY_ID="REPLACE_WITH_TENANT_EXPORT_SIGNING_KEY_ID"
TENANT_EXPORT_SIGNING_PRIVATE_KEY_BASE64="REPLACE_WITH_BASE64_PKCS8_ED25519_PRIVATE_KEY"
CONFIGURATION_PACKAGE_SIGNING_KEY_ID="REPLACE_WITH_CONFIGURATION_PACKAGE_SIGNING_KEY_ID"
CONFIGURATION_PACKAGE_SIGNING_PRIVATE_KEY_BASE64="REPLACE_WITH_BASE64_PKCS8_ED25519_PRIVATE_KEY"
CONFIGURATION_PACKAGE_TRUSTED_PUBLIC_KEYS_JSON='{"approved-source-key-id":"BASE64_SPKI_ED25519_PUBLIC_KEY"}'
TENANT_EXPORT_POLL_INTERVAL_SECONDS="10"
TENANT_EXPORT_BATCH_SIZE="2"
TENANT_EXPORT_CLAIM_TIMEOUT_SECONDS="300"
TENANT_EXPORT_MAX_ATTEMPTS="5"
TENANT_EXPORT_RETRY_BASE_SECONDS="10"
TENANT_EXPORT_RETRY_MAX_SECONDS="900"
TENANT_EXPORT_EXPIRY_HOURS="168"
RETENTION_WORKER_INTERVAL_SECONDS="60"
RETENTION_ENVIRONMENT_BATCH_SIZE="100"
RETENTION_EVENT_BATCH_SIZE="500"
MINIO_API_PORT="9010"
MINIO_CONSOLE_PORT="9011"
MEILISEARCH_PORT="7700"
MEILISEARCH_MASTER_KEY="REPLACE_WITH_RANDOM_MEILISEARCH_MASTER_KEY"

# Auth
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_ACCESS_SECRET_MIN_32_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_RANDOM_REFRESH_SECRET_MIN_32_CHARS"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
# Public workflow callback registered with the tenant identity provider. Production requires HTTPS.
OIDC_REDIRECT_URI="https://REPLACE_WITH_WORKFLOW_HOST/api/auth/oidc/callback"
# Never enable outside isolated automated certification.
OIDC_ALLOW_TEST_LOOPBACK="false"

# Email (Mailpit local)
SMTP_HOST="localhost"
SMTP_PORT="1026"
SMTP_FROM="noreply@gigalibs.dev"

# App
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:5180"
API_PORT="3333"
API_HOST="0.0.0.0"
WORKFLOW_SCHEMA_VERSION="1.0"
WORKFLOW_COMPILER_VERSION="1.0"
WORKFLOW_PUBLISH_MAX_RETRIES="3"

# Workflow web BFF -> authoritative NestJS control plane
CONTROL_PLANE_API_URL="http://localhost:3333"
# Platform-owned wildcard DNS/TLS base. Tenant creation reserves <slug>.<base-domain>;
# the binding remains RESERVED until deployment infrastructure stores verification evidence.
PLATFORM_TENANT_BASE_DOMAIN="gigaplatforms.com"
EXECUTION_EVENT_SOURCE_ID="execution-plane"
EXECUTION_EVENT_SIGNING_SECRET="REPLACE_WITH_RANDOM_EXECUTION_SIGNING_SECRET_MIN_32_CHARS"
EXECUTION_EVENT_MAX_SKEW_SECONDS="300"
CONNECTOR_HTTP_ALLOWED_HOSTS=""
CONNECTOR_HTTP_ALLOWED_PORTS="443"
CONNECTOR_HTTP_ALLOW_INSECURE="false"
CONNECTOR_HTTP_ALLOW_PRIVATE_NETWORKS="false"
CONNECTOR_HTTP_TIMEOUT_SECONDS="30"
CONNECTOR_HTTP_MAX_RESPONSE_BYTES="1048576"
CONNECTOR_DATABASE_ALLOWED_HOSTS=""
CONNECTOR_DATABASE_ALLOWED_PORTS="5432"
CONNECTOR_DATABASE_ALLOW_PRIVATE_NETWORKS="false"
CONNECTOR_FAILURE_THRESHOLD="5"
CONNECTOR_CIRCUIT_COOLDOWN_SECONDS="300"
CONTROL_PAYLOAD_ENCRYPTION_KEY="REPLACE_WITH_BASE64_ENCODED_32_BYTE_CONTROL_KEY"
CONTROL_PAYLOAD_KEY_VERSION="deployment-key-version"
# Optional bounded JSON map of prior version -> base64 key during rotation. Remove a prior
# key only after every dependent TOTP/OIDC credential, in-flight login and retained payload
# has been rewrapped, expired or removed under policy.
CONTROL_PAYLOAD_PREVIOUS_KEYS_JSON=""
CONTROL_OUTBOX_POLL_INTERVAL_SECONDS="2"
CONTROL_OUTBOX_BATCH_SIZE="50"
CONTROL_OUTBOX_CLAIM_TIMEOUT_SECONDS="60"
CONTROL_OUTBOX_MAX_ATTEMPTS="10"
CONTROL_OUTBOX_RETRY_BASE_SECONDS="2"
CONTROL_OUTBOX_RETRY_MAX_SECONDS="300"
OBSERVABILITY_METRICS_TOKEN="REPLACE_WITH_RANDOM_METRICS_TOKEN_MIN_32_CHARS"

# Execution plane (separate persistence and runtime policy)
EXECUTION_ENV="development"
EXECUTION_DEBUG="false"
EXECUTION_LOG_LEVEL="INFO"
EXECUTION_API_HOST="0.0.0.0"
EXECUTION_API_PORT="8000"
EXECUTION_API_WORKERS="1"
EXECUTION_PLANE_API_URL="http://localhost:8000"
BFF_MAX_REQUEST_BYTES="1048576"
EXECUTION_DATABASE_URL="postgresql+asyncpg://execution:REPLACE_WITH_EXECUTION_DB_PASSWORD@localhost:5434/gigalibs_execution"
EXECUTION_DB_USER="execution"
EXECUTION_DB_PASSWORD="REPLACE_WITH_EXECUTION_DB_PASSWORD"
EXECUTION_DB_NAME="gigalibs_execution"
EXECUTION_DB_PORT="5434"
EXECUTION_REDIS_PASSWORD="REPLACE_WITH_EXECUTION_REDIS_PASSWORD"
EXECUTION_REDIS_PORT="6382"
EXECUTION_DB_POOL_SIZE="10"
EXECUTION_DB_MAX_OVERFLOW="20"
CELERY_BROKER_URL="redis://:REPLACE_WITH_EXECUTION_REDIS_PASSWORD@localhost:6382/0"
CELERY_RESULT_BACKEND="redis://:REPLACE_WITH_EXECUTION_REDIS_PASSWORD@localhost:6382/1"
CELERY_VISIBILITY_TIMEOUT_SECONDS="600"
CELERY_RESULT_EXPIRES_SECONDS="86400"
CONTROL_PLANE_TIMEOUT_SECONDS="5"
EXECUTION_TASK_SOFT_TIME_LIMIT_SECONDS="270"
EXECUTION_TASK_TIME_LIMIT_SECONDS="300"
EXECUTION_LEASE_SECONDS="360"
EXECUTION_MAX_ATTEMPTS="3"
EXECUTION_RETRY_BASE_SECONDS="1"
OUTBOX_BATCH_SIZE="50"
OUTBOX_POLL_INTERVAL_SECONDS="2"
OUTBOX_MAX_ATTEMPTS="10"
OUTBOX_RETRY_MAX_SECONDS="300"
EXECUTION_CORS_ORIGINS='["http://localhost:3200"]'
EXECUTION_HTTP_ALLOWED_HOSTS="[]"
EXECUTION_ALLOW_INSECURE_HTTP="false"
EXECUTION_HTTP_ALLOW_PRIVATE_NETWORKS="false"
EXECUTION_HTTP_TIMEOUT_SECONDS="30"
EXECUTION_HTTP_MAX_RESPONSE_BYTES="1048576"
EXECUTION_PAYLOAD_ENCRYPTION_KEY="REPLACE_WITH_BASE64_ENCODED_32_BYTE_EXECUTION_KEY"
EXECUTION_PAYLOAD_KEY_VERSION="deployment-key-version"

# ── Workflow Platform (Next.js) ───────────────────────────────────────────────
# Optional: display banner in AR module to identify the deployment environment.
# Examples: "local", "staging", "sandbox"
NEXT_PUBLIC_ENV_LABEL=""

# Feature flag: opt-in to the FormEngine renderer for configuration surfaces.
# When "true", ConfigurationRenderer uses FormEngineConfigurationForm backed by
# @react-form-builder/core and Medusa UI instead of the legacy ConfigurationForm.
# Defaults to false (legacy renderer) when unset.
NEXT_PUBLIC_USE_FORM_ENGINE="false"
