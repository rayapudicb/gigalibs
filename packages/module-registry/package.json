{
  "name": "@gigalibs/module-registry",
  "version": "0.1.0",
  "description": "Validated module manifests, dependency resolution, and compatibility checks",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "semver": "^7.7.2",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/semver": "^7.7.1",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
