{
  "name": "@gigalibs/e2e",
  "version": "0.0.1",
  "private": true,
  "description": "End-to-end Playwright certification suite for WI-OI-042",
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright show-report test-results/playwright-report",
    "uat": "bash run-uat-walkthrough.sh",
    "uat:inventory": "GIGALIBS_E2E_NONINTERACTIVE=1 bash run-uat-walkthrough.sh --inventory",
    "uat:journey": "GIGALIBS_E2E_NONINTERACTIVE=1 bash run-uat-walkthrough.sh --journey",
    "test:minimal-p2p-o2c": "playwright test specs/minimal-p2p-o2c-compose-flow.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1"
  }
}
