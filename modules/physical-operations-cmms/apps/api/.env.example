NODE_ENV=production
CMMS_API_HOST=0.0.0.0
CMMS_API_PORT=4200
CMMS_CORS_ORIGINS=https://platform.example.com
CMMS_DATABASE_URL=
CMMS_DATABASE_POOL_SIZE=10
CMMS_OIDC_ISSUER=https://identity.example.com
CMMS_OIDC_AUDIENCE=gigalibs-cmms-api
CMMS_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
CMMS_OIDC_ALGORITHMS=RS256
CMMS_OIDC_TENANT_CLAIM=tenant_id
CMMS_OIDC_PERMISSIONS_CLAIM=permissions

# Ed25519 public PEM paired with the workflow platform's private signing key.
# Supply this through a secret manager; do not commit the real key.
PLATFORM_CONTEXT_PUBLIC_KEY=
