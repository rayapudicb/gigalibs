-- __TITLE__ foundation (generated by `pnpm module:new`, WI-OI-085). Forward-only.
--
-- Records plus the audit, outbox and revocation tables every module on the SDK uses. Every table carries forced RLS
-- on app.tenant_id. The module migration runner enforces append-only and read-only tables
-- (MODULE_APPEND_ONLY_TABLES, MODULE_READ_ONLY_TABLES) and the least-privilege runtime role.

BEGIN;

CREATE SCHEMA IF NOT EXISTS __SCHEMA__;

CREATE TABLE IF NOT EXISTS __SCHEMA__.schema_migrations (
  version    bigint PRIMARY KEY,
  name       text NOT NULL UNIQUE,
  applied_at timestamptz NOT NULL DEFAULT transaction_timestamp(),
  CHECK (version > 0),
  CHECK (char_length(name) BETWEEN 1 AND 200)
);

CREATE TABLE __SCHEMA__.records (
  id UUID PRIMARY KEY,
  tenant_id VARCHAR(64) NOT NULL,
  request_key UUID NOT NULL,
  title VARCHAR(200) NOT NULL CHECK (char_length(btrim(title)) > 0),
  status VARCHAR(16) NOT NULL DEFAULT 'OPEN' CHECK (status IN ('OPEN', 'CLOSED')),
  version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
  created_by VARCHAR(128) NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  UNIQUE (tenant_id, request_key)
);
CREATE INDEX records_tenant_updated ON __SCHEMA__.records (tenant_id, updated_at DESC);

CREATE TABLE __SCHEMA__.auth_revocation_events (
  id VARCHAR(64) PRIMARY KEY,
  tenant_id VARCHAR(64) NOT NULL,
  revocation_type VARCHAR(32) NOT NULL CHECK (revocation_type IN ('SESSION', 'SUBJECT_AUTH_VERSION')),
  session_id VARCHAR(128),
  subject_id VARCHAR(128),
  invalid_through_auth_version INTEGER,
  reason VARCHAR(256) NOT NULL,
  occurred_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  CHECK (
    (revocation_type = 'SESSION' AND session_id IS NOT NULL
      AND subject_id IS NULL AND invalid_through_auth_version IS NULL)
    OR
    (revocation_type = 'SUBJECT_AUTH_VERSION' AND session_id IS NULL
      AND subject_id IS NOT NULL AND invalid_through_auth_version IS NOT NULL)
  )
);
CREATE INDEX auth_revocation_events_session_lookup
  ON __SCHEMA__.auth_revocation_events (tenant_id, session_id) WHERE revocation_type = 'SESSION';
CREATE INDEX auth_revocation_events_subject_lookup
  ON __SCHEMA__.auth_revocation_events (tenant_id, subject_id, invalid_through_auth_version)
  WHERE revocation_type = 'SUBJECT_AUTH_VERSION';

CREATE TABLE __SCHEMA__.audit_events (
  id VARCHAR(64) PRIMARY KEY,
  tenant_id VARCHAR(64) NOT NULL,
  actor_subject VARCHAR(128) NOT NULL,
  action VARCHAR(128) NOT NULL,
  entity_type VARCHAR(128) NOT NULL,
  entity_id VARCHAR(128),
  correlation_id VARCHAR(128) NOT NULL,
  payload JSONB NOT NULL DEFAULT '{}'::jsonb,
  occurred_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX audit_events_tenant_time ON __SCHEMA__.audit_events (tenant_id, occurred_at DESC);

CREATE TABLE __SCHEMA__.outbox_events (
  id VARCHAR(64) PRIMARY KEY,
  tenant_id VARCHAR(64) NOT NULL,
  topic VARCHAR(128) NOT NULL,
  event_type VARCHAR(128) NOT NULL,
  aggregate_type VARCHAR(128) NOT NULL,
  aggregate_id VARCHAR(128) NOT NULL,
  aggregate_version INTEGER NOT NULL CHECK (aggregate_version > 0),
  correlation_id VARCHAR(128) NOT NULL,
  causation_id VARCHAR(128),
  schema_version INTEGER NOT NULL CHECK (schema_version > 0),
  payload JSONB NOT NULL,
  status VARCHAR(16) NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING', 'PUBLISHED', 'FAILED')),
  attempt_count INTEGER NOT NULL DEFAULT 0 CHECK (attempt_count >= 0),
  available_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  published_at TIMESTAMPTZ,
  last_error_code VARCHAR(128),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  UNIQUE (tenant_id, aggregate_type, aggregate_id, aggregate_version, event_type)
);
CREATE INDEX outbox_events_delivery ON __SCHEMA__.outbox_events (status, available_at, created_at);

DO $$
DECLARE
  relation text;
BEGIN
  FOREACH relation IN ARRAY ARRAY['records', 'auth_revocation_events', 'audit_events', 'outbox_events'] LOOP
    EXECUTE format('ALTER TABLE __SCHEMA__.%I ENABLE ROW LEVEL SECURITY', relation);
    EXECUTE format('ALTER TABLE __SCHEMA__.%I FORCE ROW LEVEL SECURITY', relation);
    EXECUTE format(
      'CREATE POLICY %I ON __SCHEMA__.%I FOR ALL USING (tenant_id = NULLIF(current_setting(''app.tenant_id'', true), '''')) WITH CHECK (tenant_id = NULLIF(current_setting(''app.tenant_id'', true), ''''))',
      relation || '_tenant_isolation',
      relation
    );
  END LOOP;
END
$$;

INSERT INTO __SCHEMA__.schema_migrations (version, name)
VALUES (1, '000001___SNAKE___foundation');

COMMIT;
