{
  "name": "@gigalibs/logger",
  "version": "0.0.1",
  "description": "Structured JSON logging with Pino. Correlation IDs. Log drain adapters",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
