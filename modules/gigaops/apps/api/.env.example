NODE_ENV=development
WORKFORCE_API_HOST=127.0.0.1
WORKFORCE_API_PORT=4700
WORKFORCE_CORS_ORIGINS=http://localhost:5180
WORKFORCE_DATABASE_URL=postgresql://gigalibs_workforce_runtime:REPLACE_WITH_PASSWORD@localhost:5440/gigalibs
WORKFORCE_DATABASE_POOL_SIZE=10
WORKFORCE_EXPECTED_MIGRATION_VERSION=18
WORKFORCE_PLATFORM_CONTEXT_AUDIENCE=gigalibs-workforce-api
# Configure exactly one verification-key representation.
WORKFORCE_PLATFORM_CONTEXT_PUBLIC_KEY_BASE64=REPLACE_WITH_ED25519_SPKI_DER_BASE64
WORKFORCE_INBOX_RELAY_PUBLIC_KEY_BASE64=REPLACE_WITH_ED25519_SPKI_DER_BASE64
WORKFORCE_RELAY_CMMS_URL=http://cmms-api:4200
CMMS_INBOX_RELAY_PRIVATE_KEY_BASE64=REPLACE_WITH_ED25519_PKCS8_DER_BASE64
WORKFORCE_RELAY_ANALYTICS_URL=http://analytics-api:4400
ANALYTICS_WORKFORCE_INBOX_RELAY_PRIVATE_KEY_BASE64=REPLACE_WITH_ED25519_PKCS8_DER_BASE64
