# configuration-local-development-v1 only. Copy to .env and replace every REPLACE_* value.
# Never commit .env. Keep it mode 0600. This profile reuses PostgreSQL and MinIO from
# docker/docker-compose.dev.yml; it does not deploy or own those dependencies.

PROFILE_KEY=configuration-local-development-v1
EXECUTION_CLASS=LOCAL_DEVELOPMENT
ENVIRONMENT_KEY=local-development
RELEASE_ID=local-REPLACE_WITH_RELEASE_ID
EVIDENCE_ID=local-pending
SOURCE_REVISION=REPLACE_WITH_FULL_GIT_COMMIT
SOURCE_STATE_SHA256=REPLACE_WITH_SOURCE_STATE_SHA256
PUBLIC_ORIGIN=http://localhost:5180

# Locally built revision-qualified images. pull_policy is never.
MIGRATIONS_IMAGE=gigalibs/control-plane-migrations:REPLACE_WITH_REVISION_AND_SOURCE_STATE
API_IMAGE=gigalibs/playground-api:REPLACE_WITH_REVISION_AND_SOURCE_STATE
WEB_IMAGE=gigalibs/workflow-platform:REPLACE_WITH_REVISION_AND_SOURCE_STATE

# Existing local dependency endpoints as seen from application containers.
DATABASE_URL=postgresql://gigalibs:REPLACE_WITH_CONTROL_DB_PASSWORD@uat-postgres:5432/gigalibs
CONTROL_DB_USER=gigalibs
CONTROL_DB_NAME=gigalibs
CONTROL_POSTGRES_CONTAINER=gigalibs-postgres
MINIO_CONTAINER=docker-minio-1
STORAGE_ENDPOINT=http://host.docker.internal:9010
STORAGE_ACCESS_KEY=gigalibs
STORAGE_SECRET_KEY=REPLACE_WITH_STORAGE_SECRET_KEY
STORAGE_BUCKET=gigalibs-dev
STORAGE_REGION=us-east-1

# Host-only application ports.
API_PUBLIC_PORT=3333
WEB_PUBLIC_PORT=5180

# Authentication and encrypted control payloads.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_ACCESS_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# WI-OI-120cf: the signed mobile app profiles the /mobile/v1 BFF serves, comma-separated (the pilot app is
# gigalibs-universal). Empty turns mobile sign-in off.
MOBILE_APP_PROFILES=
# The oldest mobile app version served (e.g. 1.2.0); older apps are told to update. Empty: any version.
MOBILE_MIN_APP_VERSION=
CONTROL_PAYLOAD_ENCRYPTION_KEY=REPLACE_WITH_CANONICAL_BASE64_32_BYTE_KEY
CONTROL_PAYLOAD_KEY_VERSION=local-v1
CONTROL_PAYLOAD_PREVIOUS_KEYS_JSON=

# Configuration package signing. Private key is base64 PKCS8 DER; trusted values are base64 SPKI DER.
CONFIGURATION_PACKAGE_SIGNING_KEY_ID=local-configuration-signer-v1
CONFIGURATION_PACKAGE_SIGNING_PRIVATE_KEY_BASE64=REPLACE_WITH_BASE64_PKCS8_ED25519_PRIVATE_KEY
CONFIGURATION_PACKAGE_TRUSTED_PUBLIC_KEYS_JSON={"local-configuration-signer-v1":"REPLACE_WITH_BASE64_SPKI_ED25519_PUBLIC_KEY"}
CONFIGURATION_RUNTIME_ENVIRONMENT_KEY=local-uat

# Required control-plane startup policy.
WORKFLOW_SCHEMA_VERSION=1.0
WORKFLOW_COMPILER_VERSION=1.0
WORKFLOW_PUBLISH_MAX_RETRIES=3
EXECUTION_EVENT_SOURCE_ID=local-execution-plane
EXECUTION_EVENT_SIGNING_SECRET=REPLACE_WITH_RANDOM_EXECUTION_SIGNING_SECRET_MIN_32_CHARS
EXECUTION_EVENT_MAX_SKEW_SECONDS=300
CONNECTOR_HTTP_ALLOWED_HOSTS=
CONNECTOR_HTTP_ALLOWED_PORTS=443
CONNECTOR_HTTP_TIMEOUT_SECONDS=30
CONNECTOR_HTTP_MAX_RESPONSE_BYTES=1048576
CONNECTOR_DATABASE_ALLOWED_HOSTS=
CONNECTOR_DATABASE_ALLOWED_PORTS=5432
CONNECTOR_FAILURE_THRESHOLD=5
CONNECTOR_CIRCUIT_COOLDOWN_SECONDS=300
STORAGE_PRESIGN_SECONDS=900
STORAGE_MAX_FILE_BYTES=10485760
STORAGE_CLEANUP_INTERVAL_SECONDS=60
STORAGE_CLEANUP_BATCH_SIZE=100
RETENTION_WORKER_INTERVAL_SECONDS=60
RETENTION_ENVIRONMENT_BATCH_SIZE=100
RETENTION_EVENT_BATCH_SIZE=500
CONTROL_OUTBOX_POLL_INTERVAL_SECONDS=2
CONTROL_OUTBOX_BATCH_SIZE=50
CONTROL_OUTBOX_CLAIM_TIMEOUT_SECONDS=60
CONTROL_OUTBOX_MAX_ATTEMPTS=10
CONTROL_OUTBOX_RETRY_BASE_SECONDS=2
CONTROL_OUTBOX_RETRY_MAX_SECONDS=300
OBSERVABILITY_METRICS_TOKEN=REPLACE_WITH_RANDOM_METRICS_TOKEN_MIN_32_CHARS

# Web BFF and presentation-only options.
BFF_MAX_REQUEST_BYTES=1048576
# UAT instance only (WI-OI-120a): `enabled` lists every module, including PLANNED/CONTAINED ones, with UAT labels.
# Readiness, entitlements and permissions still apply. Any other value keeps locked modules closed.
GIGALIBS_UAT_PREVIEW=disabled
NEXT_PUBLIC_ENV_LABEL=local
NEXT_PUBLIC_USE_FORM_ENGINE=false

# Optional BFF module upstreams. Leave unset until the corresponding bounded
# local runtime is explicitly enabled; an empty value never activates a module.
AR_API_URL=
SPEND_API_URL=
TAX_API_URL=
CURRENCY_API_URL=
CONNECTOR_HUB_API_URL=
DATA_STUDIO_API_URL=
RULES_API_URL=
WORKFLOW_STUDIO_API_URL=
RECOVERY_API_URL=
ANALYTICS_API_URL=
ESIGN_API_URL=
CMMS_API_URL=
IOT_API_URL=
IOT_DATABASE_URL=
IOT_IMAGE=
IOT_PLATFORM_CONTEXT_PUBLIC_KEY_BASE64=
IOT_PLATFORM_CONTEXT_PRIVATE_KEY_BASE64=
IOT_RELAY_CMMS_URL=
IOT_CMMS_RELAY_PRIVATE_KEY_BASE64=
CMMS_RELAY_ANALYTICS_URL=
ANALYTICS_CMMS_INBOX_RELAY_PUBLIC_KEY_BASE64=
ANALYTICS_CMMS_INBOX_RELAY_PRIVATE_KEY_BASE64=
# WI-OI-131: control plane → Analytics entitlement snapshots (playground signs, analytics verifies).
ANALYTICS_ENTITLEMENT_RELAY_URL=
ANALYTICS_CONTROL_PLANE_INBOX_RELAY_PUBLIC_KEY_BASE64=
ANALYTICS_CONTROL_PLANE_INBOX_RELAY_PRIVATE_KEY_BASE64=
# WI-OI-131 B7: Analytics pulls authoritative entitlement snapshots when relay events were missed.
ANALYTICS_ENTITLEMENT_RECONCILE_URL=http://playground-api:3000/internal/v1/analytics/tenant-entitlements/{tenantId}
ANALYTICS_ENTITLEMENT_RECONCILE_TOKEN=
ANALYTICS_ENTITLEMENT_RECONCILE_INTERVAL_MS=300000
WORKFORCE_API_URL=
OPERATOR_ROUNDS_PLATFORM_CONTEXT_PRIVATE_KEY_BASE64=
# WI-OI-134: the control plane signs CMMS contexts for mobile calibration (the CMMS module key). Empty: unavailable.
CMMS_PLATFORM_CONTEXT_PRIVATE_KEY_BASE64=
OPERATOR_ROUNDS_MEDIA_ENDPOINT=
OPERATOR_ROUNDS_MEDIA_PUBLIC_ENDPOINT=
OPERATOR_ROUNDS_MEDIA_REGION=
OPERATOR_ROUNDS_MEDIA_BUCKET=
OPERATOR_ROUNDS_MEDIA_ACCESS_KEY=
OPERATOR_ROUNDS_MEDIA_SECRET_KEY=
OPERATOR_ROUNDS_RELAY_CMMS_URL=
CMMS_ROUNDS_INBOX_RELAY_PUBLIC_KEY_BASE64=
OPERATOR_ROUNDS_CMMS_INBOX_RELAY_PRIVATE_KEY_BASE64=
OPERATOR_ROUNDS_RELAY_WORKFORCE_URL=
OPERATOR_ROUNDS_WORKFORCE_INBOX_RELAY_PRIVATE_KEY_BASE64=
WORKFORCE_ROUNDS_INBOX_RELAY_PUBLIC_KEY_BASE64=
OPERATOR_ROUNDS_RELAY_ANALYTICS_URL=
OPERATOR_ROUNDS_ANALYTICS_INBOX_RELAY_PRIVATE_KEY_BASE64=
ANALYTICS_ROUNDS_INBOX_RELAY_PUBLIC_KEY_BASE64=
