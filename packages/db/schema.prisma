// ═══════════════════════════════════════════════════════════════════════
// ENTERPRISE SPEND, PROJECT BUDGETS & EXPENSE CLAIMS
// ═══════════════════════════════════════════════════════════════════════

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
  PROJECT_LIFETIME
}

enum BudgetStatus {
  ACTIVE
  EXCEEDED
  CLOSED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REIMBURSED
  REJECTED
}

enum BillingPassThrough {
  BILLABLE
  NON_BILLABLE
}

model Budget {
  id               String           @id @default(cuid())
  tenantId         String
  name             String
  code             String // e.g. BDG-WB-STAGE4
  projectId        String?
  department       String?
  period           BudgetPeriod     @default(PROJECT_LIFETIME)
  totalLimitCents  BigInt
  warnThresholdPct Int              @default(80)
  spentCents       BigInt           @default(0)
  currency         String           @default("USD")
  status           BudgetStatus     @default(ACTIVE)
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  categories       BudgetCategory[]
  expenses         ExpenseClaim[]

  @@unique([tenantId, code])
  @@index([tenantId, projectId])
  @@map("budgets")
}

model BudgetCategory {
  id           String   @id @default(cuid())
  tenantId     String
  budgetId     String
  budget       Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryName String // Travel, Equipment, Catering, Consulting, Software
  limitCents   BigInt
  spentCents   BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, budgetId])
  @@map("budget_categories")
}

model ExpenseClaim {
  id              String             @id @default(cuid())
  tenantId        String
  claimNumber     String // e.g. EXP-2026-101
  budgetId        String?
  budget          Budget?            @relation(fields: [budgetId], references: [id])
  projectId       String?
  claimantName    String // Worker / Crew member
  claimantEmail   String?
  merchant        String // Delta Airlines, Amazon, Home Depot
  category        String // Travel, Equipment Rental, Meals
  amountCents     BigInt
  currency        String             @default("USD")
  passThrough     BillingPassThrough @default(NON_BILLABLE)
  markupPercent   Float              @default(0.0)
  receiptUrl      String?
  receiptOcrText  String?
  status          ExpenseStatus      @default(SUBMITTED)
  rejectionReason String?
  approvedBy      String?
  approvedAt      DateTime?
  reimbursedAt    DateTime?
  expenseDate     DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([tenantId, claimNumber])
  @@index([tenantId, status])
  @@index([tenantId, projectId])
  @@map("expense_claims")
}

model VendorSubscription {
  id              String   @id @default(cuid())
  tenantId        String
  vendorName      String // AWS, Slack, GitHub, Figma, Twilio
  serviceCategory String // Cloud Infrastructure, Developer Tools, Communication
  cadence         String // MONTHLY, ANNUAL
  amountCents     BigInt
  currency        String   @default("USD")
  autoRenew       Boolean  @default(true)
  nextRenewalDate DateTime
  ownerEmail      String?
  seatsAllocated  Int?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@map("vendor_subscriptions")
}
