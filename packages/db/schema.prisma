model FormSchema {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title            String
  description      String?
  mode             String   @default("OPERATIONAL") // OPERATIONAL | PUBLIC | HYBRID
  isPublic         Boolean  @default(false)
  publicSlug       String?  @unique
  spatialNodeId    String?
  equipmentTag     String?
  targetWorkflowId String?
  category         String   @default("OPERATIONAL")
  schemaAst        Json     // FormEngine.io JSON fields & validation rules
  status           String   @default("PUBLISHED")

  submissions      FormSubmission[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@index([publicSlug])
  @@index([spatialNodeId])
  @@map("form_schemas")
}

model FormSubmission {
  id                 String     @id @default(cuid())
  formId             String
  form               FormSchema @relation(fields: [formId], references: [id], onDelete: Cascade)

  submissionMode     String     @default("OPERATIONAL")
  spatialNodeId      String?
  equipmentTag       String?
  clientSubmissionId String?    @unique
  submittedBy        String?
  ipAddress          String?
  deviceMetadata     Json?
  payload            Json
  status             String     @default("SUBMITTED")

  createdAt          DateTime   @default(now())

  @@index([formId])
  @@index([clientSubmissionId])
  @@index([spatialNodeId])
  @@map("form_submissions")
}

