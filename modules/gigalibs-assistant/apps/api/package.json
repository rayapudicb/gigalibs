{
  "name": "@gigalibs/gigalibs-assistant-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../../../.. modules/gigalibs-assistant/apps/api/src",
    "proof:real-database": "node scripts/real-database-proof.mjs"
  },
  "dependencies": {
    "@gigalibs/auth-core": "workspace:*",
    "@gigalibs/contracts": "workspace:*",
    "@gigalibs/module-sdk": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
