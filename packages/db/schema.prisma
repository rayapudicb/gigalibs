  accountNumber           String
  name                    String
  dba                     String?
  email                   String
  phone                   String?
  website                 String?
  country                 String  @default("US")
  stateOrProvince         String?
  city                    String?
  postalCode              String?
  addressLine1            String?
  addressLine2            String?
