apiVersion: modules.gigalibs.io/v1
kind: Module
metadata:
  name: __NAME__
  displayName: __TITLE__
  version: 0.1.0-dev
  lifecycle: implementation
  # Generated by `pnpm module:new` (WI-OI-085). Register a work item before the module leaves PLANNED.
  workItem: __WORK_ITEM__
spec:
  standalone: true
  category: __CATEGORY__
  requiredModules: []
  optionalModules: []
  capabilities:
    - __NAME__-records
  # Pages (WI-OI-083b): the generic records screen from the core web SDK until the module needs its own screens.
  ui:
    basePath: /__NAME__
    package: '@gigalibs/web-sdk'
    pages:
      - route: /__NAME__
        component: RecordsWorkspace
        props:
          gateway: __NAME__
          title: __TITLE__
  api:
    application: apps/api
    port: __PORT__
    upstream:
      key: __NAME__
      serviceHostname: __SERVICE__
      environmentKey: __PREFIX___API_URL
      __BASE_PATH_LINE__
    version: v1
  database:
    engine: postgresql
    minimumVersion: '16'
    ownsSchema: true
    defaultSchema: __SCHEMA__
    crossSchemaAccess: false
    runtimeManifest: db/runtime-manifest.txt
  # host: runs inside the shared module host (product vision §8, WI-OI-085e); service: its own image and service.
  runtime:
    generated: true
    hosting: __HOSTING__
    appendOnlyTables: [audit_events]
    readOnlyTables: [auth_revocation_events]
  catalog:
    - key: __NAME__
      name: __TITLE__
      navigationLabel: __TITLE__
      area: __TITLE__
      navigationGroup: __GROUP__
      route: /__NAME__
      iconKey: __ICON__
      readiness: PLANNED
      entitlementEligible: true
      trialEligible: false
      requiredPermission: __PERMISSION__.records.read
      platformInspection: false
      reason: Generated by module:new. It stays PLANNED until it passes `pnpm module:conformance __NAME__ --live` and is reviewed.
      navigationOrder: __ORDER__
  # Web gateway (WI-OI-083): the BFF reaches only these routes, as the user, with a freshly signed context.
  gateway:
    basePaths: [/api/__NAME__]
    catalogKey: __NAME__
    audience: gigalibs-__NAME__-api
    upstream: __NAME__
    signingKeyEnvironment: __PREFIX___PLATFORM_CONTEXT_PRIVATE_KEY_BASE64
    codePrefix: __PREFIX__
    routeNoun: __TITLE__
    serviceName: __TITLE__
    entitlementName: __TITLE__
    routes:
      - { path: 'v1/records', GET: __PERMISSION__.records.read, POST: __PERMISSION__.records.manage }
      - { path: 'v1/records/{id}', GET: __PERMISSION__.records.read, PATCH: __PERMISSION__.records.manage }
