{
  "name": "@gigalibs/universal-orders-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../../../.. modules/universal-orders/apps/api/src",
    "proof:real-database": "tsx scripts/real-database-proof.ts",
    "proof:minimal-o2c": "tsx scripts/minimal-o2c-business-flow.ts"
  },
  "dependencies": {
    "@gigalibs/auth-core": "workspace:*",
    "@gigalibs/configuration-core": "workspace:*",
    "@gigalibs/contracts": "workspace:*",
    "@gigalibs/module-sdk": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "helmet": "^8.1.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
