{
  "id": "gigalibs.chat",
  "name": "2-Way Real-Time WebSocket Team Chat",
  "version": "1.0.0",
  "description": "Real-time WebSocket chat channels, direct messaging, threaded replies, read receipts, emoji reactions, and file attachments",
  "capabilities": [
    "realtime-websocket",
    "channel-management",
    "direct-messages",
    "threaded-replies",
    "read-receipts"
  ],
  "requires": {
    "gigalibs.tenancy": "^1.0.0",
    "gigalibs.users": "^1.0.0"
  },
  "optional": {
    "gigalibs.presence": "^1.0.0",
    "gigalibs.notifications": "^1.0.0",
    "gigalibs.storage": "^1.0.0"
  },
  "permissions": [
    "chat.channel.read",
    "chat.channel.create",
    "chat.message.send",
    "chat.message.delete",
    "chat.reaction.add"
  ],
  "eventsProduced": [
    "chat.message_sent.v1",
    "chat.reaction_added.v1",
    "chat.user_typing.v1"
  ],
  "eventsConsumed": [
    "tenant.created.v1",
    "user.deactivated.v1"
  ],
  "configurationNamespace": "chat",
  "healthChecks": [
    "websocket-gateway"
  ]
}
