{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@gigalibs/broker": [
        "../../packages/broker/dist/index.d.ts"
      ],
      "@gigalibs/logger": [
        "../../packages/logger/dist/index.d.ts"
      ],
      "@gigalibs/ar-domain": [
        "../../modules/accounts-receivable/domain/dist/index.d.ts"
      ],
      "@gigalibs/charts-react": [
        "../../packages/charts-react/dist/index.d.ts"
      ],
      "@gigalibs/maps-core": [
        "../../packages/maps-core/dist/index.d.ts"
      ],
      "@gigalibs/maps-react": [
        "../../packages/maps-react/dist/index.d.ts"
      ],
      "@gigalibs/i18n": [
        "../../packages/i18n/dist/index.d.ts"
      ],
      "@gigalibs/db": [
        "../../packages/db/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-iam-cert/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
