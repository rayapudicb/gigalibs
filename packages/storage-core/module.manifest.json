{
  "id": "gigalibs.storage",
  "name": "Multi-Provider Object Storage",
  "version": "1.0.0",
  "description": "Multi-provider cloud object storage interface (AWS S3, Google Cloud Storage, Azure Blob), pre-signed uploads, and malware scanning triggers",
  "capabilities": [
    "presigned-urls",
    "multipart-uploads",
    "mime-type-validation",
    "filename-normalization"
  ],
  "requires": {
    "gigalibs.tenancy": "^1.0.0",
    "gigalibs.audit": "^1.0.0"
  },
  "optional": {},
  "permissions": [
    "storage.file.read",
    "storage.file.upload",
    "storage.file.delete"
  ],
  "eventsProduced": [
    "storage.file_uploaded.v1",
    "storage.file_deleted.v1"
  ],
  "eventsConsumed": [
    "tenant.created.v1"
  ],
  "configurationNamespace": "storage",
  "healthChecks": [
    "storage-provider"
  ]
}
