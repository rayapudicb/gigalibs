# Copy to a non-versioned .env and replace every REPLACE_* value. No working credentials are provided.
NODE_ENV=development
AR_API_HOST=0.0.0.0
AR_API_PORT=3400
AR_CORS_ORIGINS=http://localhost:3401
AR_DATABASE_URL=postgresql://ar_runtime:REPLACE_WITH_RANDOM_PASSWORD@localhost:5432/ar
AR_DATABASE_POOL_SIZE=20
AR_OIDC_ISSUER=https://REPLACE_WITH_TRUSTED_ISSUER
AR_OIDC_AUDIENCE=gigalibs-ar
AR_OIDC_JWKS_URI=https://REPLACE_WITH_TRUSTED_ISSUER/.well-known/jwks.json
AR_OIDC_ALGORITHMS=RS256
AR_OIDC_TENANT_CLAIM=tenant_id
AR_OIDC_PERMISSIONS_CLAIM=permissions
AR_ALLOW_INSECURE_OIDC=false

# Standalone web BFF. Use one 32-byte base64 value for AR_WEB_SESSION_SECRET.
AR_WEB_BASE_URL=http://localhost:3401
AR_API_BASE_URL=http://localhost:3400
AR_WEB_OIDC_ISSUER=https://REPLACE_WITH_TRUSTED_ISSUER
AR_WEB_OIDC_CLIENT_ID=REPLACE_WITH_CONFIDENTIAL_CLIENT_ID
AR_WEB_OIDC_CLIENT_SECRET=REPLACE_WITH_RANDOM_CLIENT_SECRET
AR_WEB_OIDC_SCOPE=openid profile offline_access gigalibs-ar
AR_WEB_SESSION_SECRET=REPLACE_WITH_32_BYTE_BASE64_VALUE
AR_WEB_ALLOW_INSECURE_HTTP=true

# Outbox worker. The login role must be a member of gigalibs_ar_outbox_worker.
AR_WORKER_DATABASE_URL=postgresql://ar_worker:REPLACE_WITH_RANDOM_PASSWORD@localhost:5432/ar
AR_EVENT_WEBHOOK_URL=https://REPLACE_WITH_EVENT_RECEIVER/events
AR_EVENT_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AR_WORKER_ID=REPLACE_WITH_STABLE_INSTANCE_ID
AR_WORKER_POLL_INTERVAL_MS=1000
AR_WORKER_HTTP_TIMEOUT_MS=5000
AR_WORKER_LEASE_SECONDS=60
AR_WORKER_MAX_ATTEMPTS=20
AR_WORKER_ALLOW_INSECURE_HTTP=false
