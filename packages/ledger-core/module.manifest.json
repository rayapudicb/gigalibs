{
  "id": "gigalibs.ledger",
  "name": "Double-Entry Financial General Ledger",
  "version": "1.0.0",
  "description": "Immutable GAAP/IFRS compliant general ledger enforcing fundamental Debits == Credits invariant with Chart of Accounts and journal reversals",
  "capabilities": [
    "chart-of-accounts",
    "journal-entries",
    "debits-credits-invariant",
    "trial-balance",
    "ledger-reversals"
  ],
  "requires": {
    "gigalibs.tenancy": "^1.0.0",
    "gigalibs.audit": "^1.0.0"
  },
  "optional": {
    "gigalibs.currency": "^1.0.0"
  },
  "permissions": [
    "ledger.account.read",
    "ledger.account.create",
    "ledger.journal.post",
    "ledger.journal.reverse",
    "ledger.report.read"
  ],
  "eventsProduced": [
    "ledger.entry_posted.v1",
    "ledger.entry_reversed.v1"
  ],
  "eventsConsumed": [
    "tenant.created.v1",
    "invoice.paid.v1"
  ],
  "configurationNamespace": "ledger",
  "healthChecks": [
    "database"
  ]
}
