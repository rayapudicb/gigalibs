# WI-OI-120bo: the isolated test stack (Docker Compose project gigalibs-test). Never UAT.
# Do not copy this file by hand: infra/compose/scripts/generate-test-stack-credentials.sh writes e2e/test.env
# (gitignored, mode 0600) with random passwords, and seed-test-e2e-principals.mjs creates these accounts from it.

GIGALIBS_E2E_TARGET=test-stack
PLAYWRIGHT_TEST_BASE_URL=http://127.0.0.1:5181
E2E_UAT_TENANT="GigaLibs Test Stack"
E2E_UAT_ADMIN_EMAIL=e2e.admin@gigalibs-test.invalid
E2E_UAT_ADMIN_PASSWORD=
E2E_UAT_APPROVER_EMAIL=e2e.approver@gigalibs-test.invalid
E2E_UAT_APPROVER_PASSWORD=
