// ═══════════════════════════════════════════════════════════════════════
// ENTERPRISE SPEND, PROJECT BUDGETS & EXPENSE CLAIMS
// ═══════════════════════════════════════════════════════════════════════

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
  PROJECT_LIFETIME
}

enum BudgetStatus {
  ACTIVE
  EXCEEDED
  CLOSED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REIMBURSED
  REJECTED
}

enum BillingPassThrough {
  BILLABLE
  NON_BILLABLE
}

model Budget {
  id               String           @id @default(cuid())
  tenantId         String
  name             String
  code             String // e.g. BDG-WB-STAGE4
  projectId        String?
  department       String?
  period           BudgetPeriod     @default(PROJECT_LIFETIME)
  totalLimitCents  BigInt
  warnThresholdPct Int              @default(80)
  spentCents       BigInt           @default(0)
  currency         String           @default("USD")
  status           BudgetStatus     @default(ACTIVE)
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  categories       BudgetCategory[]
  expenses         ExpenseClaim[]

  @@unique([tenantId, code])
  @@index([tenantId, projectId])
  @@map("budgets")
}

model BudgetCategory {
  id           String   @id @default(cuid())
  tenantId     String
  budgetId     String
  budget       Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryName String // Travel, Equipment, Catering, Consulting, Software
  limitCents   BigInt
  spentCents   BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, budgetId])
  @@map("budget_categories")
}

model ExpenseClaim {
  id              String             @id @default(cuid())
  tenantId        String
  claimNumber     String // e.g. EXP-2026-101
  budgetId        String?
  budget          Budget?            @relation(fields: [budgetId], references: [id])
  projectId       String?
  claimantName    String // Worker / Crew member
  claimantEmail   String?
  merchant        String // Delta Airlines, Amazon, Home Depot
  category        String // Travel, Equipment Rental, Meals
  amountCents     BigInt
  currency        String             @default("USD")
  passThrough     BillingPassThrough @default(NON_BILLABLE)
  markupPercent   Float              @default(0.0)
  receiptUrl      String?
  receiptOcrText  String?
  status          ExpenseStatus      @default(SUBMITTED)
  rejectionReason String?
  approvedBy      String?
  approvedAt      DateTime?
  reimbursedAt    DateTime?
  expenseDate     DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([tenantId, claimNumber])
  @@index([tenantId, status])
  @@index([tenantId, projectId])
  @@map("expense_claims")
}

model VendorSubscription {
  id              String   @id @default(cuid())
  tenantId        String
  vendorName      String // AWS, Slack, GitHub, Figma, Twilio
  serviceCategory String // Cloud Infrastructure, Developer Tools, Communication
  cadence         String // MONTHLY, ANNUAL
  amountCents     BigInt
  currency        String   @default("USD")
  autoRenew       Boolean  @default(true)
  nextRenewalDate DateTime
  ownerEmail      String?
  seatsAllocated  Int?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@map("vendor_subscriptions")
}

// ═══════════════════════════════════════════════════════════════════════
// GOVERNED UNIVERSAL CONFIGURATION STUDIO (WI-OI-039)
// ═══════════════════════════════════════════════════════════════════════

model ConfigurationChangeSet {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  moduleKey           String
  entityKey           String
  surfaceKey          String
  status              String   @default("DRAFT")
  definition          Json
  compiledManifest    Json?
  checksum            String?
  findings            Json     @default("[]")
  compatibility       String?
  reason              String
  version             Int      @default(1)
  createdById         String
  createdBy           User     @relation("ConfigurationChangeSetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  submittedAt         DateTime? @db.Timestamptz(3)
  approvedById        String?
  approvedBy          User?    @relation("ConfigurationChangeSetApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  approvedAt          DateTime? @db.Timestamptz(3)
  rejectedById        String?
  rejectedBy          User?    @relation("ConfigurationChangeSetRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rejectedAt          DateTime? @db.Timestamptz(3)
  publishedAt         DateTime? @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  publishedVersions   ConfigurationPublishedVersion[]

  @@index([tenantId, status, updatedAt(sort: Desc)], map: "configuration_change_sets_tenant_status_updated_idx")
  @@index([tenantId, moduleKey, entityKey, surfaceKey], map: "configuration_change_sets_surface_idx")
  @@map("configuration_change_sets")
}

model ConfigurationPublishedVersion {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changeSetId         String
  changeSet           ConfigurationChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  moduleKey           String
  entityKey           String
  surfaceKey          String
  sequence            Int
  manifest            Json
  checksum            String
  compilerVersion     String
  publishedById       String
  publishedBy         User     @relation("ConfigurationVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  publishedAt         DateTime @default(now()) @db.Timestamptz(3)
  activations         ConfigurationActivation[]
  extensionValues     ConfigurationExtensionValue[]
  records             ConfigurationRecord[]
  templates           ConfigurationTemplate[]

  @@unique([tenantId, moduleKey, entityKey, surfaceKey, sequence], map: "configuration_published_versi_tenantId_moduleKey_entityKey__key")
  @@unique([tenantId, checksum])
  @@index([tenantId, publishedAt(sort: Desc)], map: "configuration_published_versions_tenant_published_idx")
  @@map("configuration_published_versions")
}

model ConfigurationActivation {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publishedVersionId  String
  publishedVersion    ConfigurationPublishedVersion @relation(fields: [publishedVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  moduleKey           String
  entityKey           String
  surfaceKey          String
  environmentKey      String
  cohortKey           String
  status              String   @default("ACTIVE")
  reason              String
  activatedById       String
  activatedBy         User     @relation("ConfigurationActivationActor", fields: [activatedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  activatedAt         DateTime @default(now()) @db.Timestamptz(3)
  deactivatedAt       DateTime? @db.Timestamptz(3)

  @@index([tenantId, environmentKey, cohortKey, status], map: "configuration_activations_scope_idx")
  @@index([tenantId, moduleKey, entityKey, surfaceKey, status], map: "configuration_activations_surface_status_idx")
  @@map("configuration_activations")
}

model ConfigurationExtensionValue {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ownerType           String
  ownerId             String
  publishedVersionId  String
  publishedVersion    ConfigurationPublishedVersion @relation(fields: [publishedVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  manifestChecksum    String
  values              Json
  valuesChecksum      String
  version             Int      @default(1)
  createdById         String
  createdBy           User     @relation("ConfigurationExtensionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updatedById         String
  updatedBy           User     @relation("ConfigurationExtensionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, ownerType, ownerId])
  @@index([tenantId, publishedVersionId], map: "configuration_extension_values_version_idx")
  @@map("configuration_extension_values")
}

model ConfigurationIdempotencyRecord {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actorId              String
  actor                User     @relation("ConfigurationIdempotencyActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  operation            String
  idempotencyKey       String
  requestChecksum      String
  response             Json
  statusCode           Int
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, actorId, operation, idempotencyKey], map: "configuration_idempotency_rec_tenantId_actorId_operation_id_key")
  @@index([tenantId, createdAt(sort: Desc)], map: "configuration_idempotency_tenant_created_idx")
  @@map("configuration_idempotency_records")
}

model ConfigurationRecord {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entityKey           String
  publishedVersionId String
  publishedVersion   ConfigurationPublishedVersion @relation(fields: [publishedVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  manifestChecksum   String
  values             Json
  valuesChecksum     String
  version            Int      @default(1)
  createdById        String
  createdBy          User     @relation("ConfigurationRecordCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updatedById        String
  updatedBy          User     @relation("ConfigurationRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)

  @@index([tenantId, entityKey, deletedAt, updatedAt(sort: Desc)], map: "configuration_records_tenant_entity_deleted_updated_idx")
  @@index([tenantId, publishedVersionId], map: "configuration_records_tenant_published_version_idx")
  @@map("configuration_records")
}

model ConfigurationTemplate {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entityKey          String
  name               String
  description        String?
  publishedVersionId String
  publishedVersion   ConfigurationPublishedVersion @relation(fields: [publishedVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  manifestChecksum   String
  values             Json
  valuesChecksum     String
  sourceTemplateId   String?
  sourceTemplate     ConfigurationTemplate?  @relation("TemplateClones", fields: [sourceTemplateId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  clones             ConfigurationTemplate[] @relation("TemplateClones")
  version            Int      @default(1)
  createdById        String
  createdBy          User     @relation("ConfigurationTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updatedById        String
  updatedBy          User     @relation("ConfigurationTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)

  @@index([tenantId, entityKey, deletedAt, updatedAt(sort: Desc)], map: "configuration_templates_tenant_entity_idx")
  @@index([tenantId, publishedVersionId], map: "configuration_templates_tenant_published_idx")
  @@map("configuration_templates")
}

model ConfigurationSavedFilter {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entityKey       String
  name            String
  filterKey       String?
  filterValue     String?
  search          String?
  sortKey         String?
  sortDirection   String   @default("DESC")
  createdById     String
  createdBy       User     @relation("ConfigurationSavedFilterCreatedBy", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([tenantId, entityKey, createdAt(sort: Desc)], map: "configuration_saved_filters_tenant_entity_idx")
  @@index([createdById], map: "configuration_saved_filters_creator_idx")
  @@map("configuration_saved_filters")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — Durable Saga State Machine (replaces in-memory sagaOrchestratorStore)
// ─────────────────────────────────────────────────────────────────────────────

model SagaInstance {
  id                    String     @id @default(cuid())
  tenantId              String
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sagaType              String     // DISPUTE_ESCROW_SETTLEMENT | GRID_CONTINGENCY_FAILOVER | TREASURY_RTGS_SETTLEMENT
  status                String     @default("STARTED") // STARTED | IN_PROGRESS | COMPLETED | COMPENSATING | COMPENSATED | FAILED
  payload               Json
  compensationTriggered Boolean    @default(false)
  auditLedgerDigest     String?
  logSummary            String[]   @default([])
  steps                 SagaStep[]
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  completedAt           DateTime?  @db.Timestamptz(3)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("saga_instances")
}

model SagaStep {
  id                  String       @id @default(cuid())
  sagaInstanceId      String
  sagaInstance        SagaInstance @relation(fields: [sagaInstanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stepIndex           Int
  name                String
  targetSystem        String       // SAP_S4HANA | SALESFORCE_CRM | TREASURY_DTS | CRYPTOGRAPHIC_VAULT | SCADA_GRID
  forwardAction       String
  compensatingAction  String
  status              String       @default("PENDING") // PENDING | EXECUTING | SUCCESS | FAILED | COMPENSATED
  fipsSha256Checksum  String?
  errorMessage        String?
  executedAt          DateTime?    @db.Timestamptz(3)
  compensatedAt       DateTime?    @db.Timestamptz(3)

  @@index([sagaInstanceId, stepIndex])
  @@map("saga_steps")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — Durable Governor Rate Buckets (replaces in-memory Map<tenantId, BucketState>)
// ─────────────────────────────────────────────────────────────────────────────

model TenantRateBucket {
  tenantId              String   @id
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tier                  String   @default("STANDARD") // FREE | STANDARD | PRO | ENTERPRISE
  tokens                Float    @default(0)
  lastRefillTimestampMs BigInt
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("tenant_rate_buckets")
}
