{
  "id": "gigalibs.sla",
  "name": "SLA Policy & Breach Engine",
  "version": "1.0.0",
  "description": "Service Level Agreement policy evaluator, First Response Time, Resolution countdowns, and automated breach alarms",
  "capabilities": [
    "sla-policies",
    "frt-monitoring",
    "resolution-countdown",
    "breach-detection",
    "escalation-triggers"
  ],
  "requires": {
    "gigalibs.tenancy": "^1.0.0"
  },
  "optional": {
    "gigalibs.notifications": "^1.0.0"
  },
  "permissions": [
    "sla.policy.read",
    "sla.policy.manage"
  ],
  "eventsProduced": [
    "sla.warning.v1",
    "sla.breached.v1"
  ],
  "eventsConsumed": [
    "ticket.created.v1",
    "ticket.resolved.v1"
  ],
  "configurationNamespace": "sla",
  "healthChecks": [
    "sla-timer"
  ]
}
