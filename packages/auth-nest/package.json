{
  "name": "@gigalibs/auth-nest",
  "version": "0.0.1",
  "description": "JWT, Passkey/WebAuthn, OTP, Password, Social OAuth, Sessions [nest]",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@gigalibs/auth-core": "workspace:*",
    "@gigalibs/contracts": "workspace:*",
    "@gigalibs/db": "workspace:*",
    "@gigalibs/validation-nest": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
