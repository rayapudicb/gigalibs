  "rules": {
    "CORE_IMPORTS_MODULE": "Core code must not import module-owned code.",
    "MODULE_IMPORTS_MODULE": "A module must not import another module's code; use published contracts (@gigalibs/contracts), APIs and events.",
    "IMPORTS_SHELL": "Nothing imports the shell; it is the composition root.",
    "IMPORTS_TOOLING": "Shipped code must not import test or build tooling."
  },
