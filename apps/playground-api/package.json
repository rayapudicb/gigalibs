{
  "name": "@gigalibs/app-playground-api",
  "version": "0.0.1",
  "description": "Production control-plane API for workflow and operational intelligence",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --root ../.. --config vitest.config.ts apps/playground-api/src",
    "verify:e2e": "node scripts/verify-control-plane.mjs",
    "verify:workflow": "node scripts/verify-operational-workflow.mjs",
    "verify:operational-intelligence": "node scripts/verify-operational-intelligence.mjs",
    "verify:ap-outcome": "node scripts/verify-ap-outcome.mjs",
    "verify:retention": "node scripts/verify-retention.mjs",
    "verify:observability": "node scripts/verify-observability.mjs",
    "verify:execution-observability": "node scripts/verify-execution-observability.mjs",
    "verify:postgres16-recovery": "node ../../scripts/verify-postgres16-backup-restore.mjs",
    "verify:tenant-lifecycle": "node scripts/verify-platform-tenant-lifecycle.mjs",
    "verify:spatial-scope-session": "node scripts/verify-spatial-scope-session.mjs",
    "verify:analytics-web-path": "node scripts/verify-analytics-web-path.mjs",
    "verify:governed-catalogues": "node scripts/verify-governed-catalogues.mjs",
    "verify:configuration-studio": "node scripts/verify-configuration-studio.mjs",
    "verify:configuration-studio-http": "node scripts/verify-configuration-studio-http.mjs",
    "verify:configuration-studio-http-local": "node scripts/verify-configuration-studio-http-local.mjs",
    "verify:configuration-studio-replicas": "node scripts/verify-configuration-studio-replicas.mjs",
    "verify:configuration-studio-upgrade": "node scripts/verify-configuration-studio-upgrade.mjs",
    "verify:configuration-studio-performance": "node scripts/verify-configuration-studio-performance.mjs",
    "verify:configuration-studio-database-restart": "node scripts/verify-configuration-studio-database-restart.mjs",
    "verify:configuration-studio-contracts": "node ../../scripts/verify-configuration-contracts.mjs",
    "verify:configuration-studio-observability": "node ../../scripts/verify-configuration-observability.mjs",
    "verify:configuration-studio-observability-live": "node scripts/verify-configuration-studio-observability-live.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .next .turbo",
    "verify:cmms-web-path": "node scripts/verify-cmms-web-path.mjs",
    "verify:workforce-jobs-web-path": "node scripts/verify-workforce-jobs-web-path.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@gigalibs/audit-nest": "workspace:*",
    "@gigalibs/auth-core": "workspace:*",
    "@gigalibs/auth-nest": "workspace:*",
    "@gigalibs/configuration-core": "workspace:*",
    "@gigalibs/contracts": "workspace:*",
    "@gigalibs/crypto": "workspace:*",
    "@gigalibs/db": "workspace:*",
    "@gigalibs/jobs": "workspace:*",
    "@gigalibs/logger": "workspace:*",
    "@gigalibs/module-registry": "workspace:*",
    "@gigalibs/module-registry-nest": "workspace:*",
    "@gigalibs/platform-settings-nest": "workspace:*",
    "@gigalibs/privacy-gdpr": "workspace:*",
    "@gigalibs/rbac-nest": "workspace:*",
    "@gigalibs/rbac-core": "workspace:*",
    "@gigalibs/tenancy-nest": "workspace:*",
    "@gigalibs/validation-nest": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@gigalibs/module-sdk": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
