/**
 * __TITLE__ (generated by `pnpm module:new`, WI-OI-085): configuration, signed-context authorization on the real
 * routes, and the V1 contract. Live behaviour is checked by `pnpm module:conformance __NAME__ --live`.
 */
import 'reflect-metadata';
import { generateKeyPairSync } from 'node:crypto';
import { type PlatformContextV1, signPlatformContextToken } from '@gigalibs/auth-core';
import { ForbiddenException, UnauthorizedException, type ExecutionContext } from '@nestjs/common';
import { describe, expect, it } from 'vitest';
import { AuthorizationGuard } from './authorization.js';
import { AUDIENCE, MODULE_KEY, runtimeConfigProvider } from './config.js';
import type { DatabaseService } from './database.service.js';
import { CreateRecordV1, UpdateRecordV1 } from './records/records.contract.js';
import { RecordsController } from './records/records.controller.js';

const pem = { privateKeyEncoding: { type: 'pkcs8', format: 'pem' }, publicKeyEncoding: { type: 'spki', format: 'pem' } } as const;
const signer = generateKeyPairSync('ed25519', pem);
const publicKeyBase64 = generateKeyPairSync('ed25519').publicKey.export({ format: 'der', type: 'spki' }).toString('base64');

const environment = {
  __PREFIX___PLATFORM_CONTEXT_AUDIENCE: AUDIENCE,
  __PREFIX___API_HOST: '0.0.0.0',
  __PREFIX___API_PORT: '__PORT__',
  __PREFIX___CORS_ORIGINS: 'http://127.0.0.1:5180',
  __PREFIX___DATABASE_URL: 'postgresql://runtime:secret@postgres:5432/gigalibs',
  __PREFIX___DATABASE_POOL_SIZE: '10',
  __PREFIX___EXPECTED_MIGRATION_VERSION: '1',
  __PREFIX___PLATFORM_CONTEXT_PUBLIC_KEY_BASE64: publicKeyBase64,
};

function claims(overrides: Partial<PlatformContextV1> = {}): PlatformContextV1 {
  const now = Math.floor(Date.now() / 1000);
  return {
    iss: 'gigalibs-control-plane',
    aud: AUDIENCE,
    sub: 'user00000000000000000001',
    tenant_id: 'tenant000000000000000001',
    session_id: 'session-1',
    auth_version: 1,
    roles: ['TENANT_ADMIN'],
    granted_scopes: ['__PERMISSION__.records.read'],
    persona_type: 'TENANT_ADMIN',
    org_scope: { mode: 'FLAT_TENANT' },
    entitlement: { module_key: MODULE_KEY, status: 'ENABLED', version: 'v1' },
    iat: now,
    exp: now + 60,
    jti: 'jti-1',
    ...overrides,
  };
}

function authorize(handler: keyof RecordsController, overrides: Partial<PlatformContextV1> = {}) {
  const request = { headers: { authorization: `Bearer ${signPlatformContextToken(claims(overrides), signer.privateKey)}` } };
  const context = {
    switchToHttp: () => ({ getRequest: () => request }),
    getHandler: () => RecordsController.prototype[handler],
    getClass: () => RecordsController,
  } as unknown as ExecutionContext;
  const database = { isContextRevoked: async () => false } as unknown as DatabaseService;
  const config = { platformContextPublicKey: signer.publicKey, platformContextAudience: AUDIENCE };
  return new AuthorizationGuard(config as never, database).canActivate(context);
}

describe('__TITLE__ runtime configuration', () => {
  const load = (overrides: Record<string, string> = {}) => {
    const saved = { ...process.env };
    Object.assign(process.env, environment, overrides);
    try {
      return (runtimeConfigProvider as { useFactory: () => unknown }).useFactory();
    } finally {
      process.env = saved;
    }
  };
  it('loads the __PREFIX___* variables', () => {
    expect(load()).toMatchObject({ apiPort: __PORT__, platformContextAudience: AUDIENCE, expectedMigrationVersion: 1 });
  });
  it('refuses another audience', () => {
    expect(() => load({ __PREFIX___PLATFORM_CONTEXT_AUDIENCE: 'gigalibs-other-api' })).toThrow(AUDIENCE);
  });
});

describe('__TITLE__ authorization on the real routes', () => {
  it('lets a reader list records', async () => {
    await expect(authorize('list')).resolves.toBe(true);
  });
  it('refuses a reader who tries to create a record', async () => {
    await expect(authorize('create')).rejects.toBeInstanceOf(ForbiddenException);
  });
  it('lets a manager create a record', async () => {
    await expect(authorize('create', { granted_scopes: ['__PERMISSION__.records.manage'] })).resolves.toBe(true);
  });
  it('refuses a context for another module', async () => {
    await expect(
      authorize('list', { entitlement: { module_key: 'asset-maintenance', status: 'ENABLED', version: 'v1' } }),
    ).rejects.toBeInstanceOf(ForbiddenException);
  });
  it('refuses a context for another audience', async () => {
    await expect(authorize('list', { aud: 'gigalibs-cmms-api' })).rejects.toBeInstanceOf(UnauthorizedException);
  });
});

describe('__TITLE__ V1 contract', () => {
  it('requires a request key and a title', () => {
    expect(CreateRecordV1.safeParse({ requestKey: 'x', title: 'A' }).success).toBe(false);
    expect(CreateRecordV1.safeParse({ requestKey: '5b9f7c1e-4d2a-4e8b-9c3f-1a2b3c4d5e6f', title: '  ' }).success).toBe(false);
    expect(CreateRecordV1.safeParse({ requestKey: '5b9f7c1e-4d2a-4e8b-9c3f-1a2b3c4d5e6f', title: 'A' }).success).toBe(true);
  });
  it('refuses unknown fields and empty changes', () => {
    expect(CreateRecordV1.safeParse({ requestKey: '5b9f7c1e-4d2a-4e8b-9c3f-1a2b3c4d5e6f', title: 'A', tenantId: 'x' }).success).toBe(false);
    expect(UpdateRecordV1.safeParse({ version: 1 }).success).toBe(false);
    expect(UpdateRecordV1.safeParse({ version: 1, status: 'CLOSED' }).success).toBe(true);
  });
});
