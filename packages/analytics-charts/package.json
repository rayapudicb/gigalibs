{
  "name": "@gigalibs/analytics-charts",
  "version": "0.0.1",
  "description": "Chart options for Analytics results, shared by the web screens and server-drawn reports (WI-OI-106)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./workbench": {
      "import": "./dist/workbench/index.js",
      "types": "./dist/workbench/index.d.ts"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/analytics-charts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@gigalibs/contracts": "workspace:*",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
